rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ITINERARY PLANNER SECURITY MODEL
     * 
     * Core Philosophy:
     * This ruleset implements a hybrid security model designed for a travel planning application. 
     * It combines Public Read access for curated data (Activities) with a strict Ownership model 
     * for personal data (Itineraries). It also supports a "Shared via Link" mechanism using 
     * unique share codes.
     * 
     * Data Structure:
     * - /activities: A flat, top-level collection of pre-curated points of interest.
     * - /itineraries/{itineraryId}: A top-level collection of user-created plans.
     * - /itineraries/{itineraryId}/itineraryActivities/{id}: A subcollection for specific 
     *   activities mapped to an itinerary.
     * 
     * Key Security Decisions:
     * 1. Public Activities: Activities are managed by administrators (outside this scope) 
     *    and are globally readable to allow users to browse and plan without restriction.
     * 2. Denormalized Authorization: To ensure high performance and avoid costly cross-document 
     *    lookups (get() calls), 'ownerId' and 'shareCode' are denormalized from the parent 
     *    Itinerary into every ItineraryActivity document.
     * 3. Ownership-Based Writes: All modifications to itineraries and their activities 
     *    require the user's UID to match the 'ownerId' stored on the document.
     * 4. Private Sharing: Itineraries are protected from public listing. Only the owner 
     *    can list their itineraries. Individual itineraries are accessible via 'get' 
     *    requests if the user is the owner or if the document possesses a shareCode 
     *    (acting as an unlisted but accessible resource).
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the provided UID matches the authenticated user. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the document exists and the user is the owner. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the curated activities library.
     * @path /activities/{activityId}
     * @allow get, list (public)
     * @deny create, update, delete (all users)
     * @principle Public Read-Only: Curated library data is open for consumption but locked for modification.
     */
    match /activities/{activityId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Rules for top-level user itineraries.
     * @path /itineraries/{itineraryId}
     * @allow get: if owner OR if it has a share code (private link).
     * @allow list: if owner.
     * @allow create: if ownerId in data matches auth UID.
     * @allow update, delete: if user is the established owner.
     * @principle Ownership: Only the creator can manage or list their own itineraries.
     */
    match /itineraries/{itineraryId} {
      // Owners can list their itineraries. Public listing is denied.
      allow list: if isOwner(resource.data.ownerId);

      // Access is allowed if owner, OR if the document has a share code (supporting private link access).
      allow get: if isOwner(resource.data.ownerId) || (resource.data.shareCode != null);

      // Verify the creator sets themselves as the owner.
      allow create: if isOwner(request.resource.data.ownerId);

      // Verify user is existing owner and prevent transferring ownership to another UID.
      allow update: if isExistingOwner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isExistingOwner(resource.data.ownerId);

      /**
       * @description Rules for activities within a specific itinerary.
       * @path /itineraries/{itineraryId}/itineraryActivities/{itineraryActivityId}
       * @allow read: if parent itinerary owner OR via shared itinerary access.
       * @allow create: if ownerId matches and relational integrity is maintained.
       * @allow update, delete: if user is the established owner.
       * @principle Denormalized Auth: Uses fields on the document itself to avoid parent-document lookups.
       */
      match /itineraryActivities/{itineraryActivityId} {
        // Read access mirrors the parent itinerary logic using denormalized fields.
        allow list: if isOwner(resource.data.ownerId);
        allow get: if isOwner(resource.data.ownerId) || (resource.data.shareCode != null);

        // Validate that the activity belongs to the correct path and the user is the owner.
        allow create: if isOwner(request.resource.data.ownerId) && request.resource.data.itineraryId == itineraryId;

        // Ensure ownership and path consistency remain immutable during updates.
        allow update: if isExistingOwner(resource.data.ownerId) 
                      && request.resource.data.ownerId == resource.data.ownerId
                      && request.resource.data.itineraryId == resource.data.itineraryId;

        allow delete: if isExistingOwner(resource.data.ownerId);
      }
    }
  }
}