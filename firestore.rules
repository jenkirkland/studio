rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict user-ownership model for personal data while providing 
     * read access to global content. It prioritizes Authorization Independence by using 
     * path-based security and denormalized fields, ensuring rules remain performant 
     * without needing deep document lookups (get() calls).
     *
     * DATA STRUCTURE
     * 1. /activities/{activityId}: Global, curated activities accessible to all users.
     * 2. /users/{userId}/dayPlans/{dayPlanId}: User-owned travel itineraries.
     * 3. /users/{userId}/dayPlans/{dayPlanId}/dayPlanActivities/{dayPlanActivityId}: 
     *    Specific activity instances within a day plan, nested under the owner's path.
     *
     * KEY SECURITY DECISIONS
     * - Ownership is established via the {userId} path parameter for all user-specific data.
     * - Activities are read-only for standard users; write access is restricted to 
     *   administrative processes (not defined in this public-facing ruleset).
     * - Relational integrity is enforced by ensuring internal document IDs (like dayPlanId) 
     *   match the path they are stored in during creation and remain immutable.
     * - Prototyping Mode: Schema validation (types, optional fields) is omitted to allow 
     *   for rapid iteration, focusing strictly on authorization and relational links.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Verifies ownership and ensures the document exists for updates or deletes. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Publicly accessible, curated list of activities. Read-only for authenticated users.
     * @path /activities/{activityId}
     * @allow get (read) if user is signed in.
     * @deny create (write) for all standard users.
     * @principle Provides global data access while preventing unauthorized modifications.
     */
    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description User-specific day plans. Ownership is derived from the {userId} path.
     * @path /users/{userId}/dayPlans/{dayPlanId}
     * @allow list (read) if request.auth.uid == userId.
     * @deny update (write) if request.auth.uid != userId.
     * @principle Path-based ownership ensures users can only access their own itineraries.
     */
    match /users/{userId}/dayPlans/{dayPlanId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);

      /**
       * @description Activities within a specific day plan.
       * @path /users/{userId}/dayPlans/{dayPlanId}/dayPlanActivities/{dayPlanActivityId}
       * @allow create if user owns the path AND dayPlanId in data matches path.
       * @deny update if user attempts to change the dayPlanId relationship.
       * @principle Validates relational integrity between the subcollection and the parent path.
       */
      match /dayPlanActivities/{dayPlanActivityId} {
        allow get, list: if isOwner(userId);
        
        // Enforce that the document's internal dayPlanId matches the path it's created in
        allow create: if isOwner(userId) && request.resource.data.dayPlanId == dayPlanId;
        
        // Ensure the dayPlanId cannot be changed (immutability for relational integrity)
        allow update: if isExistingOwner(userId) && request.resource.data.dayPlanId == resource.data.dayPlanId;
        
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Root user document match (if required for profile creation).
     * @path /users/{userId}
     * @allow create if the auth UID matches the document ID.
     * @principle Standard Self-Creation pattern for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot be listed/discovered.
      allow create: if isOwner(userId);
      allow update, delete: if isExistingOwner(userId);
    }
  }
}